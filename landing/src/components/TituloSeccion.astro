---
interface Props {
  etiqueta: string;
  titulo: string;
  descripcion?: string;
  /** Sobre fondo oscuro invierte los colores del texto. */
  oscuro?: boolean;
  class?: string;
}

const { etiqueta, titulo, descripcion, oscuro = false, class: clase = '' } = Astro.props;
---

<div class={`revelar max-w-3xl ${clase}`}>
  <p
    class={`text-xs font-bold tracking-[0.18em] uppercase ${oscuro ? 'text-agua-300' : 'text-agua-600'}`}
  >
    {etiqueta}
  </p>
  <h2
    class={`mt-3 font-display text-3xl leading-tight font-semibold text-balance sm:text-4xl lg:text-[2.75rem] ${
      oscuro ? 'text-white' : 'text-marino-900'
    }`}
  >
    {titulo}
  </h2>
  {
    descripcion && (
      <p
        class={`mt-5 text-lg leading-relaxed text-pretty ${oscuro ? 'text-white/70' : 'text-marino-900/65'}`}
      >
        {descripcion}
      </p>
    )
  }
</div>
