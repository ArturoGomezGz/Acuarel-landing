---
import { servicios } from '../data/servicios';
import Icono from './Icono.astro';
import TituloSeccion from './TituloSeccion.astro';
---

<section id="servicios" class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <TituloSeccion
      etiqueta="Productos y servicios"
      titulo="Todo lo que su piscina necesita, con un solo proveedor"
      descripcion="Del proyecto ejecutivo al mantenimiento semanal. Trabajamos el ciclo completo, para que su piscina le dé más satisfacción que problemas."
    />

    <div class="mt-14 grid gap-6 lg:mt-16 lg:grid-cols-3">
      {
        servicios.map((servicio) => (
          <article class="revelar group flex flex-col rounded-2xl border border-arena-200 bg-arena-50/60 p-7 transition duration-300 hover:-translate-y-1 hover:border-agua-200 hover:bg-white hover:shadow-xl hover:shadow-marino-900/5 lg:p-8">
            <span class="inline-flex h-13 w-13 items-center justify-center rounded-xl bg-marino-700 p-3 text-white transition group-hover:bg-agua-500">
              <Icono nombre={servicio.icono} class="h-7 w-7" />
            </span>

            <h3 class="mt-6 font-display text-2xl font-semibold text-marino-900">
              {servicio.titulo}
            </h3>

            <p class="mt-3 leading-relaxed text-marino-900/65">{servicio.resumen}</p>

            <ul class="mt-6 space-y-2.5 border-t border-arena-200 pt-6">
              {servicio.puntos.map((punto) => (
                <li class="flex gap-3 text-[0.95rem] text-marino-900/80">
                  <Icono nombre="palomita" class="mt-1 h-4 w-4 shrink-0 text-agua-500" />
                  <span>{punto}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
