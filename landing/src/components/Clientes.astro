---
import { Image } from 'astro:assets';
import { logosClientes, clientes } from '../data/clientes';
import TituloSeccion from './TituloSeccion.astro';

/*
 * Los cinco logotipos se repiten cuatro veces y la pista se desplaza un 50 %:
 * como el patrón es periódico cada repetición, el reinicio es invisible y la
 * pista siempre es más ancha que la pantalla, sin huecos en monitores grandes.
 */
const repeticionesLogos = 4;
---

<section id="clientes" class="border-y border-arena-200 bg-arena-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <TituloSeccion
      etiqueta="Clientes"
      titulo="Nos han confiado sus albercas hoteles, gobiernos y familias"
      descripcion="Más de treinta obras entregadas en Jalisco, Nayarit, Colima, Michoacán, Sinaloa, Tabasco y Guatemala."
      class="mx-auto text-center"
    />
  </div>

  <!-- Carrusel de logotipos -->
  <div class="revelar marquee mt-14 overflow-hidden" style="--duracion: 45s">
    <ul class="marquee-pista flex items-center gap-16 sm:gap-20">
      {
        Array.from({ length: repeticionesLogos }).flatMap((_, ronda) =>
          logosClientes.map((cliente) => (
            <li class="shrink-0">
              <Image
                src={cliente.imagen}
                alt={ronda === 0 ? cliente.nombre : ''}
                widths={[160, 320]}
                sizes="160px"
                class="h-20 w-auto mix-blend-multiply grayscale transition duration-300 hover:grayscale-0"
                loading="lazy"
                aria-hidden={ronda === 0 ? undefined : 'true'}
              />
            </li>
          )),
        )
      }
    </ul>
  </div>

  <!-- Carrusel de nombres, en sentido contrario para que las dos filas no se lean como una sola -->
  <div
    class="revelar marquee mt-10 overflow-hidden"
    style="--duracion: 90s; --direccion: reverse"
  >
    <ul class="marquee-pista flex items-center gap-3">
      {
        [0, 1].flatMap((ronda) =>
          clientes.map((cliente) => (
            <li
              class="shrink-0 rounded-full border border-arena-200 bg-white px-4 py-2 text-sm whitespace-nowrap"
              aria-hidden={ronda === 0 ? undefined : 'true'}
            >
              <span class="font-semibold text-marino-900">{cliente.nombre}</span>
              <span class="text-marino-900/50"> · {cliente.ubicacion}</span>
            </li>
          )),
        )
      }
    </ul>
  </div>
</section>
