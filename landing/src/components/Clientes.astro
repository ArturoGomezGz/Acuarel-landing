---
import { Image } from 'astro:assets';
import { logosClientes, clientes } from '../data/clientes';
import TituloSeccion from './TituloSeccion.astro';
---

<section id="clientes" class="border-y border-arena-200 bg-arena-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <TituloSeccion
      etiqueta="Clientes"
      titulo="Nos han confiado sus albercas hoteles, gobiernos y familias"
      descripcion="Más de treinta obras entregadas en Jalisco, Nayarit, Colima, Michoacán, Sinaloa, Tabasco y Guatemala."
      class="mx-auto text-center"
    />

    <ul class="revelar mt-14 grid grid-cols-2 items-center gap-8 sm:grid-cols-3 lg:grid-cols-5">
      {
        logosClientes.map((cliente) => (
          <li class="flex justify-center">
            <Image
              src={cliente.imagen}
              alt={cliente.nombre}
              widths={[160, 320]}
              sizes="160px"
              class="h-20 w-auto opacity-75 mix-blend-multiply grayscale transition duration-300 hover:opacity-100 hover:grayscale-0"
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>

    <details class="revelar group mx-auto mt-14 max-w-5xl">
      <summary
        class="mx-auto flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-marino-700/25 px-5 py-2.5 text-sm font-semibold text-marino-700 transition hover:bg-marino-700 hover:text-white"
      >
        <span class="group-open:hidden">Ver los {clientes.length} clientes</span>
        <span class="hidden group-open:inline">Ocultar lista</span>
      </summary>

      <ul
        class="mt-10 grid gap-x-8 gap-y-3 border-t border-arena-200 pt-10 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          clientes.map((cliente) => (
            <li class="flex flex-col border-l-2 border-arena-200 pl-3.5 text-sm">
              <span class="font-semibold text-marino-900">{cliente.nombre}</span>
              <span class="text-marino-900/55">{cliente.ubicacion}</span>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</section>
