---
/** Íconos de línea, dibujados a mano para no cargar una librería completa. */
interface Props {
  nombre:
    | 'construccion'
    | 'equipamiento'
    | 'mantenimiento'
    | 'whatsapp'
    | 'telefono'
    | 'ubicacion'
    | 'flecha'
    | 'menu'
    | 'cerrar'
    | 'palomita';
  class?: string;
}

const { nombre, class: clase = 'h-6 w-6' } = Astro.props;
---

{
  nombre === 'construccion' && (
    <svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 21h18" />
      <path d="M5 21V9l7-5 7 5v12" />
      <path d="M9 21v-5h6v5" />
      <path d="M9 12h6" />
    </svg>
  )
}
{
  nombre === 'equipamiento' && (
    <svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3.2" />
      <path d="M12 2v3.4M12 18.6V22M2 12h3.4M18.6 12H22M4.9 4.9l2.4 2.4M16.7 16.7l2.4 2.4M19.1 4.9l-2.4 2.4M7.3 16.7l-2.4 2.4" />
    </svg>
  )
}
{
  nombre === 'mantenimiento' && (
    <svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2.7s5.6 6 5.6 9.8a5.6 5.6 0 1 1-11.2 0C6.4 8.7 12 2.7 12 2.7Z" />
      <path d="M9.4 13.4a2.6 2.6 0 0 0 2.6 2.6" />
