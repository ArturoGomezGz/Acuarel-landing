---
import { Image } from 'astro:assets';
import logo from '../assets/logo-piscinas-acuarel.png';
import { site, contacto, direccionUnaLinea } from '../data/site';
import { servicios } from '../data/servicios';

const anio = new Date().getFullYear();

const enlaces = [
  { href: '#servicios', texto: 'Servicios' },
  { href: '#proyectos', texto: 'Proyectos' },
  { href: '#nosotros', texto: 'Nosotros' },
  { href: '#clientes', texto: 'Clientes' },
  { href: '#contacto', texto: 'Contacto' },
];
---

<footer class="bg-marino-950 pt-16 pb-24 text-white/60 sm:pb-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <Image
          src={logo}
          alt="Piscinas Acuarel"
          widths={[220, 440]}
          sizes="220px"
          class="h-12 w-auto"
          loading="lazy"
        />
        <p class="mt-5 max-w-sm leading-relaxed">
          Diseño, construcción, equipamiento y mantenimiento de piscinas en concreto
          armado desde {site.fundacion}. Trabajos en toda la República Mexicana.
        </p>

        <address class="mt-6 text-sm not-italic">
          {direccionUnaLinea}
        </address>

        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          {
            contacto.telefonos.map((t) => (
              <a
                href={`tel:${t.tel}`}
                class="text-sm font-semibold text-white/85 transition hover:text-agua-300"
              >
                {t.display}
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Secciones">
        <p class="text-xs font-bold tracking-[0.18em] text-white/40 uppercase">Sitio</p>
        <ul class="mt-5 space-y-2.5">
          {
            enlaces.map((enlace) => (
              <li>
                <a href={enlace.href} class="text-sm transition hover:text-white">
                  {enlace.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="text-xs font-bold tracking-[0.18em] text-white/40 uppercase">
          Qué hacemos
        </p>
        <ul class="mt-5 space-y-2.5">
          {servicios.map((servicio) => <li class="text-sm">{servicio.titulo}</li>)}
        </ul>

        {
          contacto.redes.length > 0 && (
            <>
              <p class="mt-8 text-xs font-bold tracking-[0.18em] text-white/40 uppercase">
                Síganos
              </p>
              <ul class="mt-4 space-y-2.5">
                {contacto.redes.map((red) => (
                  <li>
                    <a
                      href={red.url}
                      target="_blank"
                      rel="noopener"
                      class="text-sm transition hover:text-white"
                    >
                      {red.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:pr-24"
    >
      <p>© {anio} {site.nombre}. Todos los derechos reservados.</p>
      <a href="/aviso-de-privacidad" class="transition hover:text-white">
        Aviso de privacidad
      </a>
    </div>
  </div>
</footer>
