---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, contacto, direccionUnaLinea } from '../data/site';

/*
 * Borrador de aviso de privacidad conforme a la LFPDPPP.
 * PENDIENTE: debe revisarlo la empresa (y de preferencia un abogado) y
 * completarse con el correo del responsable de datos antes de publicar.
 */
---

<Layout
  titulo={`Aviso de privacidad — ${site.nombre}`}
  descripcion={`Aviso de privacidad de ${site.nombre}, Zapopan, Jalisco.`}
>
  <Header />

  <main id="contenido" class="bg-white">
    <div class="mx-auto max-w-3xl px-4 pt-32 pb-20 sm:px-6 lg:px-8 lg:pt-40">
      <h1 class="font-display text-4xl font-semibold text-marino-900 sm:text-5xl">
        Aviso de privacidad
      </h1>

      <div
        class="mt-4 rounded-xl border border-oro-400/40 bg-oro-400/10 px-5 py-4 text-sm text-marino-900/80"
      >
        <strong>Borrador.</strong> Este texto es una base conforme a la LFPDPPP y debe ser
        revisado y aprobado por {site.nombre} antes de publicarse.
      </div>

      <div class="mt-10 space-y-8 leading-relaxed text-marino-900/75">
        <section>
          <h2 class="font-display text-2xl font-semibold text-marino-900">Responsable</h2>
          <p class="mt-3">
            {site.nombre}, con domicilio en {direccionUnaLinea}, es responsable del
            tratamiento de sus datos personales.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-semibold text-marino-900">
            Datos que recabamos
          </h2>
          <p class="mt-3">
            A través del formulario de contacto de este sitio recabamos su nombre,
            teléfono, correo electrónico y la descripción del proyecto sobre el que
            solicita información. No recabamos datos personales sensibles ni datos
            financieros a través de este sitio.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-semibold text-marino-900">Finalidades</h2>
          <p class="mt-3">
            Sus datos se utilizan únicamente para responder su solicitud, elaborar la
            cotización correspondiente y darle seguimiento comercial. No se transfieren a
            terceros sin su consentimiento, salvo cuando la ley lo exija.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-semibold text-marino-900">
            Derechos ARCO
          </h2>
          <p class="mt-3">
            Usted puede solicitar el acceso, rectificación, cancelación u oposición al
            tratamiento de sus datos personales, así como revocar su consentimiento,
            comunicándose a cualquiera de nuestros teléfonos:
          </p>
          <ul class="mt-4 space-y-1.5">
            {
              contacto.telefonos.map((t) => (
                <li>
                  <a
                    href={`tel:${t.tel}`}
                    class="font-semibold text-marino-700 transition hover:text-agua-600"
                  >
                    {t.display}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2 class="font-display text-2xl font-semibold text-marino-900">Cambios</h2>
          <p class="mt-3">
            Cualquier modificación a este aviso de privacidad se publicará en esta misma
            página.
          </p>
        </section>
      </div>

      <a
        href="/"
        class="mt-12 inline-flex items-center gap-2 font-semibold text-marino-700 transition hover:text-agua-600"
      >
        ← Volver al inicio
      </a>
    </div>
  </main>

  <Footer />
</Layout>
