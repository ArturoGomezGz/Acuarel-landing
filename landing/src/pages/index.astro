---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Credibilidad from '../components/Credibilidad.astro';
import Servicios from '../components/Servicios.astro';
import Proyectos from '../components/Proyectos.astro';
import Nosotros from '../components/Nosotros.astro';
import Clientes from '../components/Clientes.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import BotonWhatsapp from '../components/BotonWhatsapp.astro';
---

<Layout>
  <Header />

  <main id="contenido">
    <Hero />
    <Credibilidad />
    <Servicios />
    <Proyectos />
    <Nosotros />
    <Clientes />
    <Contacto />
  </main>

  <Footer />
  <BotonWhatsapp />
</Layout>
